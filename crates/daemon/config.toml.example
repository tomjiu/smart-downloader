# smart-dl-daemon serve 配置示例（TOML）
# 启动: smart-dl-daemon serve --config config.toml
# 所有字段可选，缺省用默认值（见 crates/daemon/src/config.rs）。

[server]
# HTTP/WS 监听地址
addr = "127.0.0.1:8787"

[download]
# 默认下载落盘根目录（add 接口未指定 dest 时使用；缺失自动创建）
dest_root = "./downloads"

[bt]
# 启用 BT 引擎（需编译 --features bt；无则仅 HTTP）
enabled = true
# BT 全局落盘目录（v1 单 session：所有 BT 任务落此目录；任务级 dest 仅接受默认
# 或与之一致——自定义 dest 会被拒绝）。缺省 = download.dest_root；启动时自动创建。
# save_path = "./downloads/bt"
# 发现层开关：默认关闭保持确定性，纯磁力无 tracker 冷启动可开启
enable_dht = false
enable_lsd = false
enable_upnp = false
# PEX（peer 交换）：默认关闭保持确定性且对私有 tracker 更友好
enable_pex = false
# uTP（UDP 传输，incoming/outgoing 同进退）：默认关闭保持确定性
enable_utp = false
# MSE 加密策略：disable=纯明文 / allow=明文+加密皆收（默认，内核行为不变）/
# require=强制加密（明文直接拒绝）
encrypt = "allow"

[lock]
# 单实例锁文件（重复启动 → 直接退出）
path = "./daemon.lock"

[storage]
# 任务持久化文件（add/remove/状态变更自动落盘；启动时恢复任务）
tasks_path = "./tasks.json"
