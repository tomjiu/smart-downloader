{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Downloader",
  "version": "0.2.1",
  "identifier": "com.mmqz.smart-dl",
  "build": {
    "frontendDist": "../../ui/out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../ui/out/": "ui/"
    },
    "externalBin": ["binaries/smart-dl-daemon"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility"
  }
}
